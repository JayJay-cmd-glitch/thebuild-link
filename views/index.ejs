
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>TheBuild Link - Free URL Shortener</title>

    <meta name="description" content="Shorten long URLs into clean, shareable links with TheBuild Link. Simple, fast, and free.">

    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <!-- Navigation -->
    <header class="navbar">

        <a href="/" class="logo">
            TheBuild<span>Link</span>
        </a>

        <nav>
            <a href="#how-it-works">How it works</a>
            <a href="#features">Features</a>
            <a href="#about">About</a>
        </nav>

        <a href="#shortener" class="nav-button">
            Shorten a link
        </a>

    </header>

    <main>

        <!-- Hero Section -->
        <section class="hero" id="shortener">

            <div class="hero-content">

                <div class="badge">
                    <span class="badge-dot"></span>
                    FREE URL SHORTENER
                </div>

                <h1>
                    Make your links<br>
                    <span>shorter & smarter.</span>
                </h1>

                <p class="hero-description">
                    Shorten long URLs into clean, shareable links.
                    Simple, fast, and completely free.
                </p>

                <!-- URL Shortener Form -->
                <div class="shortener-box">

                    <form action="/shorten" method="POST" id="shortenerForm" novalidate>

                        <label for="originalUrl">
                            Paste your long URL
                        </label>

                        <div class="input-wrapper">

                            <span class="link-icon">↗</span>

                            <input
                                type="text"
                                id="originalUrl"
                                name="originalUrl"
                                inputmode="url"
                                autocomplete="url"
                                autocapitalize="off"
                                spellcheck="false"
                                placeholder="Paste or type a link (e.g. example.com)"
                                required
                            >

                        </div>

                        <p class="input-error" id="urlError" role="alert" hidden></p>

                        <button type="submit" class="shorten-button">
                            Shorten URL
                            <span>→</span>
                        </button>

                    </form>

                    <p class="privacy-note">
                        No complicated setup. Just paste and shorten.
                    </p>

                </div>

                <!-- Trust Indicators -->
                <div class="trust-row">
                    <span>✓ Free to use</span>
                    <span>✓ Fast redirects</span>
                    <span>✓ Easy to share</span>
                </div>

            </div>

        </section>

        <!-- How It Works -->
        <section class="how-section" id="how-it-works">

            <div class="section-heading">

                <p class="section-label">
                    HOW IT WORKS
                </p>

                <h2>
                    Shorten. Share. <span>Done.</span>
                </h2>

                <p>
                    Get a shorter link in just three simple steps.
                </p>

            </div>

            <div class="steps-grid">

                <div class="step-card">

                    <div class="step-number">01</div>

                    <h3>Paste your URL</h3>

                    <p>
                        Copy your long link and paste it into
                        the input box above.
                    </p>

                </div>

                <div class="step-card">

                    <div class="step-number">02</div>

                    <h3>Shorten it</h3>

                    <p>
                        Click the shorten button and let
                        TheBuild Link create a shorter version.
                    </p>

                </div>

                <div class="step-card">

                    <div class="step-number">03</div>

                    <h3>Share anywhere</h3>

                    <p>
                        Copy your new link and share it with
                        friends, customers, or your audience.
                    </p>

                </div>

            </div>

        </section>

        <!-- Features -->
        <section class="features-section" id="features">

            <div class="section-heading">

                <p class="section-label">
                    WHY THEBUILD LINK?
                </p>

                <h2>
                    Links made <span>simple.</span>
                </h2>

            </div>

            <div class="features-grid">

                <div class="feature-card">

                    <div class="feature-icon">↗</div>

                    <h3>Easy to use</h3>

                    <p>
                        Shorten long URLs with just one click.
                    </p>

                </div>

                <div class="feature-card">

                    <div class="feature-icon">⚡</div>

                    <h3>Fast redirects</h3>

                    <p>
                        Get people to their destination
                        without unnecessary steps.
                    </p>

                </div>

                <div class="feature-card">

                    <div class="feature-icon">◎</div>

                    <h3>Track clicks</h3>

                    <p>
                        Keep track of how many times your
                        shortened links are opened.
                    </p>

                </div>

            </div>

        </section>

        <!-- About TheBuild Link -->
        <section class="about-section" id="about">

            <div class="section-heading">

                <p class="section-label">
                    ABOUT THEBUILD LINK
                </p>

                <h2>
                    A simpler way to <span>share links.</span>
                </h2>

                <p>
                    TheBuild Link is a free URL shortener that helps you turn
                    long web addresses into short, easy-to-share links.
                    Paste your link, shorten it, and share it with friends,
                    customers, or your audience.
                </p>

            </div>

        </section>

    </main>

    <!-- Footer -->
    <footer class="footer">

        <a href="/" class="logo">
            TheBuild<span>Link</span>
        </a>

        <p>
            © 2026 TheBuild Link. Built to make links simpler.
        </p>

    </footer>

    <script>
        (() => {
            const form = document.getElementById("shortenerForm");
            const input = document.getElementById("originalUrl");
            const error = document.getElementById("urlError");

            function normalizeUrl(value) {
                let candidate = value.trim();
                if (!candidate) return "";

                // Accept domains pasted without a protocol, e.g. example.com/page.
                if (!/^[a-z][a-z0-9+.-]*:\/\//i.test(candidate)) {
                    candidate = "https://" + candidate;
                }

                const parsed = new URL(candidate);
                if (!["http:", "https:"].includes(parsed.protocol) || !parsed.hostname.includes(".")) {
                    throw new Error("Enter a valid website address.");
                }
                return parsed.href;
            }

            input.addEventListener("input", () => {
                error.hidden = true;
                error.textContent = "";
                input.removeAttribute("aria-invalid");
            });

            form.addEventListener("submit", (event) => {
                try {
                    input.value = normalizeUrl(input.value);
                    if (!input.value) throw new Error("Please paste or type a link first.");
                    error.hidden = true;
                    error.textContent = "";
                    input.removeAttribute("aria-invalid");
                } catch (err) {
                    event.preventDefault();
                    error.textContent = err.message || "Please enter a valid website address.";
                    error.hidden = false;
                    input.setAttribute("aria-invalid", "true");
                    input.focus();
                }
            });
        })();
    </script>

</body>
</html>
